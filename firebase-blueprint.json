{
  "entities": {
    "Restaurant": {
      "title": "Restaurant",
      "description": "Information about a multi-tenant restaurant and its menu settings.",
      "type": "object",
      "properties": {
        "ownerUid": { "type": "string", "description": "The UID of the registered restaurant owner" },
        "slug": { "type": "string", "description": "URL slug of the restaurant (unique)" },
        "name": { "type": "string", "description": "Human-readable restaurant name" },
        "logo": { "type": "string", "format": "uri", "description": "URL of restaurant logo" },
        "cover": { "type": "string", "format": "uri", "description": "URL of restaurant hero cover image" },
        "phoneNumber": { "type": "string", "description": "WhatsApp contact number with country code, e.g., +201000000000" },
        "currency": { "type": "string", "description": "Currency abbreviation (e.g., EGP, SAR, USD)" },
        "address": { "type": "string", "description": "Physical restaurant address" },
        "subscriptionType": { "type": "string", "enum": ["free", "premium", "enterprise"], "description": "SaaS Tier status" },
        "welcomeTitle": { "type": "string", "description": "Landing banner welcome title for the customer menu viewer" },
        "welcomeSubtitle": { "type": "string", "description": "Landing banner brief description" },
        "viewsCount": { "type": "integer", "description": "Total views for the restaurant menu" },
        "whatsappOrdersCount": { "type": "integer", "description": "Total clicks to send WhatsApp order" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Timestamp when the restaurant settings were created" }
      },
      "required": ["ownerUid", "slug", "name", "phoneNumber", "currency", "subscriptionType"]
    },
    "Category": {
      "title": "Category",
      "description": "Menu category/division grouping under a specific restaurant.",
      "type": "object",
      "properties": {
        "name": { "type": "string", "description": "Category name (e.g., Pizzas, Desserts)" },
        "order": { "type": "integer", "description": "Sorting priority number" },
        "isActive": { "type": "boolean", "description": "Visibility flag in customer web app menu" }
      },
      "required": ["name", "order", "isActive"]
    },
    "Product": {
      "title": "Product",
      "description": "Specific food item or beverage variant on the menu.",
      "type": "object",
      "properties": {
        "name": { "type": "string", "description": "Product name" },
        "description": { "type": "string", "description": "Quick description, ingredients, calories details" },
        "price": { "type": "number", "description": "Selling retail price" },
        "originalPrice": { "type": "number", "description": "Original non-discounted retail price" },
        "isDiscounted": { "type": "boolean", "description": "Is this product currently discounted or on promotion" },
        "discountPrice": { "type": "number", "description": "Alternative discount price to display" },
        "image": { "type": "string", "format": "uri", "description": "Product thumbnail/full photo URL" },
        "categoryId": { "type": "string", "description": "Linked category document ID" },
        "isAvailable": { "type": "boolean", "description": "In stock/is active on menu" },
        "badge": { "type": "string", "description": "Ribbon text like HOT, NEW, VEGAN" },
        "order": { "type": "integer", "description": "Sorting priority number within category" }
      },
      "required": ["name", "price", "categoryId", "isAvailable", "order"]
    }
  },
  "firestore": {
    "/restaurants/{restaurantId}": {
      "schema": "Restaurant",
      "description": "Primary multi-tenant restaurants collection"
    },
    "/restaurants/{restaurantId}/categories/{categoryId}": {
      "schema": "Category",
      "description": "Categories subcollection for custom menu grouping"
    },
    "/restaurants/{restaurantId}/products/{productId}": {
      "schema": "Product",
      "description": "Products subcollection reflecting individual dishes/items"
    }
  }
}
